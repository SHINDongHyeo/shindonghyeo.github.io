---
import { getCollection } from 'astro:content';
import { Banner, Chip, SectionTitle } from 'shindonghyeo-ui';
import PostList from '../../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const postsByYear = Map.groupBy(posts, (post) => post.data.pubDate.getFullYear());
---

<Base title={`글 | ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<Banner
		slot="hero"
		eyebrow="Archive"
		title="모든 글"
		description={`지금까지 ${posts.length}개의 글을 썼어요.`}
	/>
	{[...postsByYear].map(([year, yearPosts]) => (
		<section>
			<SectionTitle>
				{year}
				<Chip variant="accent">{yearPosts.length}</Chip>
			</SectionTitle>
			<PostList posts={yearPosts} />
		</section>
	))}
</Base>

<style>
	section + section {
		margin-top: 56px;
	}
</style>
