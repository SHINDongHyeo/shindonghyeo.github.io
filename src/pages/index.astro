---
import { getCollection } from 'astro:content';
import { AccentText, Banner, Button, GitHubIcon, SectionTitle } from 'shindonghyeo-ui';
import PostList from '../components/PostList.astro';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts.slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<Banner slot="hero">
		<img class="avatar" src={`${GITHUB_URL}.png?size=200`} alt="신동혁 프로필 사진" width="88" height="88" />
		<p class="eyebrow">Dev Log</p>
		<h1>안녕하세요,<br /><AccentText>개발자 신동혁</AccentText>입니다.</h1>
		<p class="description">{SITE_DESCRIPTION}</p>
		<div class="actions">
			<Button variant="primary" href="/blog">글 둘러보기 →</Button>
			<Button href={GITHUB_URL} target="_blank" rel="noopener">
				<GitHubIcon size={16} />
				GitHub
			</Button>
		</div>
	</Banner>

	<SectionTitle>
		최근 글
		<a slot="action" href="/blog">전체 보기 →</a>
	</SectionTitle>
	<PostList posts={posts} />
</Base>

<style>
	.avatar {
		display: block;
		width: 88px;
		height: 88px;
		margin-bottom: 24px;
		border-radius: 50%;
		background: var(--sd-bg-elevated);
		box-shadow:
			0 0 0 4px var(--sd-bg),
			0 0 0 6px var(--sd-accent-soft),
			var(--sd-shadow);
	}
	.eyebrow {
		margin: 0 0 14px;
		color: var(--sd-accent);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	h1 {
		font-size: 2.6rem;
		line-height: 1.25;
		letter-spacing: -0.045em;
	}
	.description {
		margin: 18px 0 28px;
		color: var(--sd-text-muted);
		font-size: 1.1rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	@media (max-width: 640px) {
		.avatar {
			width: 72px;
			height: 72px;
		}
		h1 {
			font-size: 1.9rem;
		}
		.description {
			font-size: 1rem;
		}
	}
</style>
