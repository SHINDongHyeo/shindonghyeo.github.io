---
import { GitHubIcon, IconButton, Logo, Navbar, ThemeToggle } from 'shindonghyeo-ui';
import { GITHUB_URL, SITE_TITLE } from '../consts';

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
const section = '/' + (pathname.match(/[^\/]+/)?.[0] ?? '');
const links = [
	{ href: '/', label: '홈' },
	{ href: '/blog', label: '글' },
].map((link) => ({ ...link, active: link.href === section }));
---

<Navbar links={links}>
	<Fragment slot="brand">
		<Logo />
		<span class="site-title">{SITE_TITLE}</span>
	</Fragment>
	<Fragment slot="actions">
		<span class="github">
			<IconButton href={GITHUB_URL} target="_blank" rel="noopener" aria-label="GitHub">
				<GitHubIcon />
			</IconButton>
		</span>
		<ThemeToggle client:load />
	</Fragment>
	<slot />
</Navbar>

<style>
	.github {
		display: contents;
	}
	@media (max-width: 640px) {
		.github {
			display: none;
		}
		.site-title {
			font-size: 0.98rem;
		}
	}
	@media (max-width: 400px) {
		.site-title {
			display: none;
		}
	}
</style>
