---
import { Footer, Logo } from 'shindonghyeo-ui';
import { GITHUB_URL, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const today = new Date();
---

<Footer
	description={SITE_DESCRIPTION}
	links={[
		{ href: '/blog', label: '글' },
		{ href: '/about', label: '소개' },
		{ href: GITHUB_URL, label: 'GitHub', external: true },
		{ href: '/rss.xml', label: 'RSS' },
	]}
	copyright={`© ${today.getFullYear()} 신동혁. Built with Astro.`}
>
	<Fragment slot="brand">
		<Logo size={26} />
		{SITE_TITLE}
	</Fragment>
</Footer>
